# SerpApi Google Flights API Key (Required for live flight search)
SERPAPI_KEY=your_serpapi_key_here

# Local Development Port (Optional - defaults to 6003 locally; ignored on Vercel)
PORT=6003

# CORS Allowed Origins (Optional - defaults to allowing same-origin and localhost)
ALLOWED_ORIGINS=http://localhost:6003,http://127.0.0.1:6003
